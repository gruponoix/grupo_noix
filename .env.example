# Copia este archivo a `.env.local` y rellena los valores.

# Email donde llegan los mensajes del formulario de contacto.
CONTACT_TO_EMAIL=gruponoixx@gmail.com

# Remitente del correo. Sin dominio verificado en Resend, deja el de pruebas.
